# apps/api
DATABASE_URL=postgres://bugcapture:dev@localhost:5432/bugcapture
BETTER_AUTH_SECRET=dev-only-secret-change-me
BETTER_AUTH_URL=http://localhost:3000
PORT=3000

# apps/api artifact storage
ARTIFACT_DIR=data/artifacts
# S3_ENDPOINT=
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# apps/api integrations (Phase 7)
# AES-256-GCM key for integration secrets — generate: `openssl rand -hex 32`
INTEGRATIONS_KEY=<64-hex>
# set to skip the outbox delivery worker (15s interval by default)
# OUTBOX_DISABLED=1

# packages/mcp — stdio MCP server (`bun packages/mcp/src/index.ts`)
# OPENJAM_URL=http://localhost:3000
# OPENJAM_TOKEN=oj_pat_...

# testcontainers on podman (required for `bun test` suites that boot postgres)
# DOCKER_HOST=unix:///run/user/$UID/podman/podman.sock
# TESTCONTAINERS_RYUK_DISABLED=true
